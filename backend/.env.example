PORT=5000
DATABASE_URL=your_supabase_database_url
JWT_SECRET=your_jwt_secret

# Meta (Facebook & Instagram) Lead Ads Configuration
# Set in Meta App Dashboard -> Webhooks -> Page -> leadgen
META_VERIFY_TOKEN=qiro_meta_leadgen_verify_token_2026
# Generated from Meta Graph API Explorer or Meta Business Suite with leads_retrieval & pages_manage_ads
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token
# Found in Meta App Settings -> Basic -> App Secret (for X-Hub-Signature-256 verification)
META_APP_SECRET=your_meta_app_secret